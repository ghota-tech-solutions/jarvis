{
  "name": "jarvis-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "SolidJS SPA for Jarvis — Connect/gRPC-Web client of the daemon.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "gen": "buf generate",
    "gen:clean": "node -e \"require('fs').rmSync('src/lib/api/gen',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.12.1",
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/language": "^6.12.4",
    "@codemirror/merge": "^6.12.2",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.43.3",
    "@connectrpc/connect": "^2.1.2",
    "@connectrpc/connect-web": "^2.1.2",
    "@nanostores/persistent": "^1.3.4",
    "@nanostores/solid": "^1.1.1",
    "@solid-primitives/i18n": "^2.2.1",
    "@solidjs/router": "^0.16.1",
    "@tanstack/solid-query": "^5.101.1",
    "@tauri-apps/plugin-notification": "^2.3.3",
    "codemirror": "^6.0.2",
    "nanostores": "^1.3.0",
    "shiki": "^4.1.0",
    "solid-js": "^1.9.5",
    "uplot": "^1.6.32"
  },
  "devDependencies": {
    "@bufbuild/buf": "^1.71.0",
    "@bufbuild/protoc-gen-es": "^2.12.1",
    "@solidjs/testing-library": "^0.8.10",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.9.1",
    "@vitest/ui": "^4.1.7",
    "happy-dom": "^20.9.0",
    "jsdom": "^29.1.1",
    "typescript": "^6.0.3",
    "vite": "^8.1.0",
    "vite-plugin-solid": "^2.11.6",
    "vitest": "^4.1.7"
  }
}
