{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Jarvis",
  "version": "0.1.0",
  "identifier": "com.ghotatech.jarvis",
  "build": {
    "beforeDevCommand": "cd ../jarvis-web/ui && bun run dev",
    "beforeBuildCommand": "cd ../jarvis-web/ui && bun run build",
    "devUrl": "http://127.0.0.1:5173",
    "frontendDist": "../jarvis-web/ui/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Jarvis",
        "width": 1400,
        "height": 900,
        "minWidth": 800,
        "minHeight": 500,
        "decorations": true,
        "transparent": false,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:* ws://127.0.0.1:*; img-src 'self' data:; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    }
  },
  "plugins": {
    "shell": {
      "open": true
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": ["icons/icon.ico", "icons/icon.png"],
    "category": "DeveloperTool",
    "shortDescription": "Autonomous coding agent",
    "longDescription": "Jarvis is a continuous autonomous coding agent with an event-sourced ledger, multi-model routing, and Docker/native sandboxes."
  }
}
