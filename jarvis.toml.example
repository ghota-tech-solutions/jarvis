# Jarvis configuration — copy to jarvis.toml and tweak.
# Env vars (HERMES_LOCAL_*, DEEPSEEK_API_KEY) override these via ${VAR} interpolation.

[daemon]
addr = "127.0.0.1:7777"
data_dir = ".jarvis"

# --- Local providers (multi-entries supported in M5) -----------------
[providers.local.gemma]
url = "${HERMES_LOCAL_URL}"
model = "${HERMES_LOCAL_MODEL}"
api_key = "${HERMES_LOCAL_API_KEY}"
priority = 10
capabilities = { ctx_len = 128000, tool_calls = true, json_schema = true, vision = false }
# § C.M-B — tool-call dialect. Defaults to "json" (universal contract).
# Set to "gemma4_strict" for any Gemma family model — uses a tighter
# system prompt with explicit "JSON only, no markdown" framing + an
# anti-drift recovery clause that prevents the long-context "finalize
# in prose" failure mode observed in task c867ee5d.
# Possible values: "json" | "gemma4_strict" | "gemma4_native"
tool_dialect = "gemma4_strict"
# § C — Gemma 4 reflection / thinking mode. When true, the agent prepends
# the `<|think|>` token to the system prompt so the model reasons in a
# dedicated channel before answering; the daemon strips that channel
# before parsing. Off by default — turn on to trade latency for quality.
thinking = false

# --- Remote providers (enabled in M5) --------------------------------
# [providers.remote.deepseek_pro]
# url = "https://api.deepseek.com/v1"
# model = "deepseek-v4-pro"
# api_key = "${DEEPSEEK_API_KEY}"
# capabilities = { ctx_len = 200000, tool_calls = true, json_schema = true, vision = false }
# tool_dialect = "json"   # DeepSeek follows the universal contract

[routing]
default_policy = "auto"
monthly_remote_usd_cap = 50

# § T2.3 — Architect/Editor pipeline. When set, the named model is used
# by the `request_edit` tool to translate architect-level prose intent
# ("rename foo to bar in src/lib.rs") into precise apply_patch
# envelopes. The architect (your task's primary model — usually a
# remote, expensive one) stays focused on planning while the editor
# (cheap local model) handles the mechanical patch generation. Empty
# or unset disables the pipeline; the agent falls back to `apply_patch`
# directly. Format: `<kind>:<name>` matching your providers map below
# (e.g. "local:gemma", "remote:deepseek").
# editor_model = "local:gemma"

# --- Agent loop tunables --------------------------------------------------
# § T1.3 — when true, the system prompt's tool catalog is rendered compactly
# (names + descriptions only, no full JSON schemas). The agent must call
# `search_tools(query="…")` to retrieve full args schemas. Saves ~3-5 k tokens
# per turn on registries with 12+ tools (incl. MCP imports) but costs one
# extra round-trip the first time the model uses an unfamiliar tool.
# Default: false (eager — preserves pre-T1.3 behaviour).
[agent]
lazy_tool_catalog = false

[sandbox]
default_backend = "native"          # native | docker
default_net_policy = "egress_only"  # none | egress_only | full (docker only)
docker_image = "alpine:3.20"
docker_memory = "2g"
docker_cpus = 2.0
docker_autopull = true

# --- Lifecycle hooks: pre/post/on_error around tool invocations -------------
# Three phases are wired into the agent loop:
#   • [[hooks.pre_tool]]  — runs BEFORE `invoke()`. Use for snapshot, audit,
#     secret redaction, pre-flight checks. Observability only — does NOT gate.
#   • [[hooks.post_tool]] — runs AFTER a successful invocation (the Ok branch),
#     regardless of `is_error` inside the payload. Use for verification
#     (`cargo check`, lint), incremental indexing, autosave.
#   • [[hooks.on_error]]  — runs AFTER a FAILED invocation (the Err branch:
#     sandbox error, schema rejection, missing binary). Use for incident
#     logging, alerts, auto-replan triggers.
#
# Every hook entry has the same shape (match/cmd/workdir/timeout_s/label).
# Hook output is fed back to the agent as a synthetic observation on the next
# turn — tool name = `hook:<phase>:<label>` (e.g. `hook:post:cargo-check`).
# The point: the agent can no longer LIE about success — `cargo check` either
# passes or returns errors the next turn must address.
#
# `match` is a regex on the tool name. Multiple hooks can match the same tool;
# they all fire in declaration order, per phase. Hooks DO NOT trigger other
# hooks (synthetic `hook:*` events are skipped).
#
# Rust example: type-check after every patch / write.
# [[hooks.post_tool]]
# match = "apply_patch|fs_write"
# cmd = "cargo check --message-format short"
# timeout_s = 90
# label = "cargo-check"
#
# TypeScript example:
# [[hooks.post_tool]]
# match = "apply_patch|fs_write"
# cmd = "npx tsc --noEmit"
# label = "tsc"
#
# Pre-hook example: snapshot the workdir before every destructive op.
# [[hooks.pre_tool]]
# match = "apply_patch|fs_write|shell"
# cmd = "git stash push -u -m \"jarvis:pre-tool\""
# label = "snapshot"
#
# On-error hook example: log every tool failure to a file the user can tail.
# [[hooks.on_error]]
# match = ".*"
# cmd = "date >> .jarvis/tool-failures.log"
# label = "log-failure"
#
# Run unit tests after the agent says "done" (matches the `done`-marker tool
# name some agents use — adapt to your verb of choice):
# [[hooks.post_tool]]
# match = "shell"
# cmd = "cargo test --workspace --lib"
# timeout_s = 180
# label = "tests"

# --- macOS / Apple Silicon notes -------------------------------------------
# When you move this to an M-series Mac with mlx_lm.server:
#   url   = "http://127.0.0.1:8080/v1"
#   model = "mlx-community/Qwen2.5-Coder-32B-Instruct-4bit"  # or your MLX repo
#   (mlx_lm.server speaks OpenAI-compatible JSON — same provider impl as Gemma)
# The `[hooks.post_tool]` block above works identically; `chcp` is a no-op on
# macOS, and the native sandbox uses `/bin/sh -c` (UTF-8 by default).
